{
  "schemaVersion": 1,
  "id": "io.github.clear-built-dev.london-motion",
  "name": "London Motion",
  "version": "2.0.1",
  "license": "MIT",
  "author": "Shas Veeramani",
  "description": "Animated 6K London wallpapers with local-time lighting, optional live weather, moving bus, rotating Eye, clock and waving flags.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Background.qml",
    "barWidget": "ControlPanel.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.background"
  },
  "barWidget": {
    "displayName": "London Wallpaper",
    "description": "Motion, lighting and weather controls",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "center"
  }
}
